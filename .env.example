FAL_KEY=

# Lesson planning uses the first configured provider below (top to bottom),
# with fal routes as the final fallback. H3 Max video always uses FAL_KEY.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional planner model overrides per provider.
GEMINI_PLANNER_MODEL=gemini-flash-lite-latest
PLANNER_MODEL=google/gemini-3.5-flash-lite
ANTHROPIC_PLANNER_MODEL=claude-haiku-4-5
OPENAI_PLANNER_MODEL=gpt-5.4-nano
FAL_LLM_MODEL=google/gemini-2.5-flash-lite

# Class-dismissed end-card image (OpenAI Images; needs OPENAI_API_KEY)
SIGNOFF_IMAGE_MODEL=gpt-image-2
SIGNOFF_IMAGE_QUALITY=medium


# Save every rendered clip + scene JSON under recordings/<sessionId>/ (set 0 to disable)
SAVE_RECORDINGS=1

# Point the OpenAI planner route at any OpenAI-compatible server instead
# (OpenRouter, Groq, a proxy, or a local model via Ollama / LM Studio).
# Example: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  OPENAI_PLANNER_MODEL=llama3.2
OPENAI_BASE_URL=
